# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Gemini API (free tier -- the only external API this project uses) ---
# No billing/credit card required. Get a free key at:
#   https://aistudio.google.com/apikey
# Free tier has daily/per-minute rate limits (plenty for personal meeting
# volume) -- see https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash

# --- Local speech-to-text (faster-whisper, runs on CPU) ---
# Options: tiny, base, small, medium, large-v3. "small" is the speed/accuracy
# default for a 4-core CPU machine with no GPU; "medium" is more accurate but
# noticeably slower per meeting hour.
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8

# How many chunks' transcribe/diarize work run concurrently. 2 is tuned for
# a 4-core box running local Whisper/pyannote -- raise this on a VPS with
# TRANSCRIPTION_PROVIDER=assemblyai (the CPU-heavy work is offloaded, so
# concurrency is no longer bounded by local cores the same way).
CHUNK_EXECUTOR_MAX_WORKERS=2

# --- Diarization ("who said what") ---
# The Chrome extension hands over one mixed recording (everyone's audio
# combined), so this local model is what figures out who's speaking when.
# Free — not a paid API — but requires a one-time HuggingFace signup:
#   1. Sign up at https://huggingface.co
#   2. Accept the model terms at
#      https://huggingface.co/pyannote/speaker-diarization-community-1
#   3. Create a read-access token at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your-token-here

# --- AssemblyAI (optional, paid, pay-as-you-go ~$0.17/hour of audio) ---
# Used only for the chunked pipeline's pyannote-fallback branch (when DOM
# speaker-tile coverage is too sparse to trust) -- replaces local
# whisper+pyannote for just that chunk with one AssemblyAI call that does
# transcription + speaker diarization together, avoiding this box's CPU
# bottleneck. Leave blank to keep using local pyannote for that branch.
# Get a key at https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=your-assemblyai-key-here
# "auto" keeps AssemblyAI on the sparse-DOM fallback only, still running
# local Whisper/pyannote for every normal meeting -- fine for a laptop with
# no AssemblyAI key, but a real production-audit finding: a VPS deploy
# sized assuming AssemblyAI does the transcription work needs this
# explicitly set to "assemblyai" (with ASSEMBLYAI_API_KEY above also set),
# or it silently keeps running local Whisper for every meeting instead.
TRANSCRIPTION_PROVIDER=assemblyai

# --- Output storage ---
# Base directory under which each meeting gets its own dated subfolder.
BASE_STORAGE_DIR=/home/enjay/Downloads/Meeting Saathi

# Whether to keep the raw uploaded recording alongside the generated
# documents (can be large over time — many hundreds of MB per meeting).
# Default OFF: the durable backup is transcript.json/.txt, not the raw media.
KEEP_RAW_RECORDING=false

# --- Local service ---
# The Chrome extension uploads recordings to this local address.
PORT=8420

# On startup, mark any meeting still "in progress" (idle/received/transcribing/
# chunk_processing/...) whose last update is older than this many minutes as
# "failed" -- its worker thread died with the previous process, so it would
# otherwise sit "in progress" on the dashboard forever. 0 disables the sweep.
STALE_RUN_MINUTES=120

# --- Admin dashboard access ---
# The dashboard's unfiltered "everyone's meetings + usage by person" view
# lives at a URL path nobody can guess, not at / with a query string --
# <server>/<ADMIN_URL_SLUG>/login -- followed by a real username/password
# login. Any other path segment there 404s exactly like a route that
# doesn't exist (never reveals "wrong password"). Generate real values
# with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_URL_SLUG=your-own-long-random-url-slug-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-own-random-password-here
SESSION_SECRET_KEY=your-own-random-session-signing-key-here

# --- CORS (Phase 1) ---
# "*" (default) allows any origin -- fine for local/self-use. Once real
# customer accounts exist, set this to a comma-separated list of exactly the
# origins that need it: the Chrome extension's own origin
# (chrome-extension://<its-id>, visible on chrome://extensions once loaded)
# and the production website's https:// domain.
CORS_ALLOWED_ORIGINS=*

# --- Transactional email (Phase 1: OTP codes) ---
# Without this set, OTP codes are logged instead of emailed (fine for local
# dev/testing, useless for real signups). Get a free-tier key at
# https://resend.com (100 emails/day free).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Meeting Saathi <onboarding@resend.dev>

# --- Free-trial / subscription entitlement (Phase 2) ---
# All optional -- sensible defaults shown. Only applies to a caller with a
# real, paired customer identity (see CORS/pairing above); an anonymous
# caller is unaffected (Phase 1's transitional rule).
# --- Razorpay (Phase 6: subscriptions) ---
# Get keys from Dashboard > Settings > API Keys; the webhook secret is set
# when you configure the webhook URL at Dashboard > Settings > Webhooks
# (point it at https://<your-domain>/billing/webhook/razorpay).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FREE_MEETING_ALLOWANCE=3
MAX_START_ATTEMPTS_PER_DAY=10
FAIR_USE_ALERT_THRESHOLD=100
FAIR_USE_HARD_CEILING=300
MAX_MEETING_DURATION_SECONDS=10800

# Caddy config for a VPS / Oracle Cloud VM.
# Replace the domain. Caddy fetches a free HTTPS cert automatically.
# Put index.html in /var/www/meeting-saathi/ and run:  sudo systemctl reload caddy

meetingsaathi.com, www.meetingsaathi.com {
    root * /var/www/meeting-saathi
    file_server
    encode gzip zstd

    # single-page app: every path serves index.html (hash routing is client-side,
    # so this is only needed if you later add real /paths)
    try_files {path} /index.html

    header {
        Cache-Control "public, max-age=300"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
